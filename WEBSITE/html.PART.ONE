<!DOCTYPE html> <html lang="en">

<head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Olivia Forster | Character Profile</title>

<style>

* { box-sizing: border-box; margin: 0; padding: 0; }

body { background-color: #fff5f8; color: #333333; font-family: "Trebuchet MS", Arial, sans-serif; }

/* Navigation */

nav { background-color: #222222; padding: 18px 8%; display: flex; justify-content: space-between; align-items: center; }

.logo { color: #f7b6cf; font-size: 20px; font-weight: bold; letter-spacing: 1px; }

nav ul { list-style: none; display: flex; gap: 25px; }

nav ul li a { color: white; text-decoration: none; font-size: 14px; transition: 0.3s; }

nav ul li a:hover { color: #f7b6cf; }

/* Main Section */

.hero { min-height: 75vh; display: flex; justify-content: center; align-items: center; text-align: center; padding: 50px 20px; }

.hero-content { max-width: 700px; }

.small-title { color: #d66b93; font-size: 13px; margin-bottom: 15px; letter-spacing: 2px; }

h1 { font-family: "Trebuchet MS", Arial, sans-serif; font-size: 55px; font-weight: bold; color: #222222; margin-bottom: 15px; }

.hero p { font-size: 16px; line-height: 1.7; color: #666666; max-width: 600px; margin: 0 auto 30px; }

/* Button */

.button { display: inline-block; background-color: #222222; color: white; padding: 12px 28px; border-radius: 25px; text-decoration: none; font-size: 14px; transition: 0.3s; }

.button:hover { background-color: #d66b93; }

/* About Section */

.about { background-color: #222222; color: white; padding: 60px 10%; text-align: center; }

.about h2 { font-size: 32px; color: #f7b6cf; margin-bottom: 15px; }

.about p { max-width: 650px; margin: auto; line-height: 1.7; color: #eeeeee; }

/* Footer */

footer { background-color: #fff5f8; text-align: center; padding: 20px; color: #777777; font-size: 12px; }

/* Mobile */

@media (max-width: 700px) {

nav { flex-direction: column; gap: 15px; }

nav ul { gap: 15px; }

h1 { font-size: 40px; }

}

</style> </head>

<body>

<!-- Navigation -->

<nav>

<div class="logo"> OLIVIA ♡ </div>

<ul> <li><a href="Homepage.html">Home</a></li> <li><a href="About.html">About Me</a></li> <li><a href="Contact.html">Contact</a></li> </ul>

</nav>

<!-- Main Section -->

<section class="hero">

<div class="hero-content">

<div class="small-title"> MY CHARACTER PROFILE </div>

<h1>Hi, I'm Olivia ♡</h1>

<p> Welcome to my character profile! This is a project I have created to demonstrate my skills while also giving you the chance to get to know me better. </p>

<a href="About.html" class="button"> Get to know me </a>

</div>

</section>

<!-- About Section -->

<section class="about">

<h2>Meet Me ♡</h2>

<p> Hi! Explore my website to discover more about who I am, what motivates me and what makes me stand out. </p>

</section>

<!-- Footer -->

<footer>

© 2026 Olivia Forster ♡ Character Profile

</footer>

</body>

</html>
